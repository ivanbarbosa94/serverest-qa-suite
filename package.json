{
  "name": "serverest-qa-suite",
  "version": "1.0.0",
  "description": "Suíte de testes de QA (API + E2E) para o ServeRest com Cypress",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('cypress/reports',{recursive:true,force:true})\"",
    "cy:open": "cypress open",
    "test": "npm run clean && cypress run",
    "test:api": "npm run clean && cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:ui": "npm run clean && cypress run --spec \"cypress/e2e/ui/**/*.cy.js\"",
    "report:merge": "mochawesome-merge \"cypress/reports/json/*.json\" -o cypress/reports/merged.json",
    "report:html": "marge cypress/reports/merged.json -f report -o cypress/reports/html",
    "report": "npm run report:merge && npm run report:html"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
